{ The spells' descriptions for the spell page (SpellInf, #839): what each of Pool of Radiance's 56 spells does in
  this port, which follows the 1st-edition rules and its own handlers where they part from the rule book, and what
  the item spells 57..67 that Use casts do (#861; 66 is unused and has none). Each is held in runs of up to 6 display
  lines of at most 36 columns joined by #13, as string literals in code, so the text lives in the overlay and costs no
  data segment, as the journal's does. First generated by a one-time script
  that wrapped the text; maintained by hand since: edit this file directly. }
{$O+,F+}
{$I COMPILER.INC}
unit SpellTxt;

interface

const
  { the display lines in one run of a description (TextChunk) }
  CHUNK_LINES = 6;

{ The number of display lines spell's description takes, or 0 for an id this unit does not hold. }
function LineCount(spell: Byte): Byte;

{ One run of spell's description lines: chunk 0 or 1, up to CHUNK_LINES lines separated by #13, or an empty string
  past the end. }
function TextChunk(spell, chunk: Byte): string;

implementation

