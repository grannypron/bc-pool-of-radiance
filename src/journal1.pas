            'THE POOL OF RADIANCE IS'#13 +
            'GREATER STILL."'#13 +
            #13 +
            'LATER IN THE BOOK,';
        3:
          TextChunk :=
            #13 +
            '"PLACES OF MAGICAL POWER'#13 +
